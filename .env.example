# ---------------------------------------------------------------------------
# X / Twitter API credentials (OAuth 1.0a user context + app bearer token)
# ---------------------------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# Numeric user ID of the bot account (not the @handle)
BOT_USER_ID=

# Public URL of the web app. The bot puts this in replies.
# Local development: http://localhost:8000
# Production: https://your-domain.example
BASE_WEB_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------
# Keep in sync with BASE_WEB_URL. Used for canonical URLs and social metadata.
PUBLIC_BASE_URL=http://localhost:8000

# Bot handle without the @. Used for links on the landing page.
BOT_HANDLE=

SITE_NAME=GIFGrab
CONTACT_EMAIL=

# Replace with your own Buy Me a Coffee / Ko-fi / GitHub Sponsors page.
BUY_ME_A_COFFEE_URL=https://www.buymeacoffee.com/

# Port exposed by docker compose on the host.
WEB_PORT=8000

# ---------------------------------------------------------------------------
# Bot behavior and cost controls
# ---------------------------------------------------------------------------
# Relative paths are resolved from the repository root.
DATABASE_PATH=./data/state.db

# Increase this to reduce X API read volume.
POLL_INTERVAL_SECONDS=60

# Mentions API page size (5-100).
MENTION_BATCH_SIZE=100

# Safety cap for backlog pagination. Older mentions are skipped if exceeded.
MAX_MENTION_PAGES=10

# 0 disables the daily reply cap.
DAILY_REPLY_LIMIT=100

# Skip parent media longer than this many seconds (0 = no limit). X reports the
# duration, so this filter costs no bandwidth. 5s keeps the bot in "GIF only" scope.
MAX_VIDEO_DURATION_SECONDS=5

# On the first run, start from the newest existing mention instead of replying
# to old mentions. Set to false only if you intentionally want a backfill.
BOOTSTRAP_ON_FIRST_RUN=true

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Media proxy and GIF conversion
# ---------------------------------------------------------------------------
ALLOWED_MEDIA_HOSTS=video.twimg.com,pbs.twimg.com
MAX_MEDIA_BYTES=31457280
MAX_GIF_BYTES=104857600
GIF_MAX_WIDTH=640
GIF_FPS=15
FFMPEG_TIMEOUT_SECONDS=120
FFMPEG_BINARY=ffmpeg
# Optional post-processing with gifsicle (-O3 --lossy). Set to "off" to disable.
GIFSICLE_BINARY=gifsicle
# Lossy compression level for gifsicle; 0 keeps lossless optimization only.
GIF_LOSSY=60
MAX_CONCURRENT_CONVERSIONS=2
CONVERT_RATE_LIMIT_PER_MINUTE=5
DOWNLOAD_RATE_LIMIT_PER_MINUTE=60
# Homepage post lookups use X's public syndication endpoint, not the paid API.
# Per-IP lookups per minute (0 = unlimited).
RESOLVE_RATE_LIMIT_PER_MINUTE=20

# Converted GIFs are cached on disk and keyed by a hash of the source video.
# Set to "off" to disable caching. Relative paths resolve from the repo root.
# In docker compose this is overridden to /cache (a named volume).
GIF_CACHE_DIR=./data/gif-cache
# Evict oldest cached GIFs once the cache exceeds this many bytes (0 = unlimited).
GIF_CACHE_MAX_BYTES=2147483648

# Only enable this when the app is behind a trusted reverse proxy that sets
# X-Forwarded-For for every request.
TRUST_PROXY_HEADERS=false
